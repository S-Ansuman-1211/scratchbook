// ScratchBook Publications — Prisma schema
// Data model derived from: Website Flow 2026, Author Dashboard, and Website.pdf

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────── Users & Auth ─────────────────────────────

enum Role {
  CUSTOMER
  AUTHOR
  ADMIN
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  mobile       String?
  passwordHash String
  role         Role      @default(CUSTOMER)
  // Set when a user applies to become an author. They stay a CUSTOMER until an
  // admin approves the request (which promotes them to AUTHOR + creates a profile).
  authorRequestedAt DateTime?
  emailConsent      Boolean   @default(false) // agreed to receive emails/updates
  discountPercent   Int       @default(0) // admin-granted personal discount (%)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  authorProfile      AuthorProfile?
  authorApplications AuthorApplication[]
  discountRequests   DiscountRequest[]
  orders             Order[]
  cart               CartItem[]
  wishlist           WishlistItem[]
  blogComments       BlogComment[]
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookId    String
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, bookId])
  @@index([userId])
}

// A user/author asks for a discount; admin grants a percentage or rejects.
model DiscountRequest {
  id             String            @id @default(cuid())
  userId         String
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  message        String            @db.Text
  bookTitle      String?
  status         ApplicationStatus @default(PENDING)
  grantedPercent Int? // set when granted
  createdAt      DateTime          @default(now())

  @@index([userId])
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

// A customer's application to become an author (details + manuscript for review).
model AuthorApplication {
  id            String            @id @default(cuid())
  userId        String
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  phone         String
  email         String
  aadhaar       String? // optional government ID
  bio           String?           @db.Text
  genre         String? // writing genre / category
  manuscriptUrl String? // uploaded sample manuscript (PDF/DOC)
  status        ApplicationStatus @default(PENDING)
  createdAt     DateTime          @default(now())

  @@index([userId])
}

// Extra profile data for users with role = AUTHOR
model AuthorProfile {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  penName       String?
  bio           String?  @db.Text
  walletBalance Int      @default(0) // stored in paise (INR * 100)
  totalEarnings Int      @default(0) // paise
  createdAt     DateTime @default(now())

  books Book[]
}

// ───────────────────────────── Catalog: Books ─────────────────────────────

enum BookType {
  ANTHOLOGY
  SOLO
  BIOGRAPHY
  AUTOBIOGRAPHY
}

enum BookStatus {
  UPCOMING   // pre-order
  PUBLISHED  // buy now
  DRAFT
}

model Book {
  id          String     @id @default(cuid())
  title       String
  slug        String     @unique
  authorName  String? // display author(s); comma-separated for multiple authors
  description String?    @db.Text // "About the book"
  coverUrl    String? // main / front image
  backCoverUrl  String? // back image
  extraImageUrl String? // optional additional image
  type        BookType   @default(SOLO)
  status      BookStatus @default(PUBLISHED)

  // Book details (from Author Dashboard -> Book Details)
  isbn        String?
  language    String?
  genre       String?
  pages       Int?
  sizeLabel   String? // e.g. "5x8 in"
  editionLabel String? // e.g. "1st Edition, 2026"
  mrp         Int? // printed MRP in paise (for display / strike-through)
  stock       Int? // available quantity
  discountPercent Int @default(0) // admin discount on this book (%)

  // External marketplace links
  amazonUrl     String?
  kindleUrl     String? // ebook redirect (regional books may have none)
  otherStoreUrl String?

  // Pricing in paise (INR * 100)
  paperbackPrice Int? // null => format not available
  hardcasePrice  Int?
  ebookPrice     Int?
  printCost      Int? @default(0) // print cost per book (author copies)

  publishedAt DateTime?
  createdAt   DateTime  @default(now())

  authorProfileId String?
  author          AuthorProfile? @relation(fields: [authorProfileId], references: [id])

  orderItems OrderItem[]
  sales      SaleRecord[]
  wishlistItems WishlistItem[]
}

// Aggregated sales per channel (Sales Insight section of dashboard)
enum SalesChannel {
  DIRECT     // Author copies
  AMAZON
  BOOKSTORE
  EBOOK_STORE
}

model SaleRecord {
  id          String       @id @default(cuid())
  bookId      String
  book        Book         @relation(fields: [bookId], references: [id], onDelete: Cascade)
  channel     SalesChannel
  copiesSold  Int          @default(0)
  profitEarned Int         @default(0) // paise
  periodMonth DateTime // first day of the month this record covers
  createdAt   DateTime     @default(now())

  @@index([bookId])
}

// ───────────────────────────── Services catalog ─────────────────────────────
// Workshops, Publishing packages, Branding, Promotions, Writing services, etc.

enum ServiceCategory {
  WORKSHOP
  PUBLISHING
  PACKAGE          // SB Basic/Bronze/Silver/Gold/Crystal/Deluxe/Diamond/Platinum/Radium
  BRANDING
  DIGITAL_PROMOTION
  WRITING_SERVICE
  POST_RELEASE     // the 12 promotion services (giveaway, reviews, etc.)
  GIFTS
  PREMIUM          // dashboard premium services
}

model Service {
  id          String          @id @default(cuid())
  name        String
  slug        String          @unique
  category    ServiceCategory
  summary     String?         @db.Text
  description String?         @db.Text
  // Some services have tiered/slot-based pricing (e.g. 30/50/100 slots).
  // Stored as JSON list of { label, price } where price is in paise.
  priceTiers  Json? // e.g. [{ "label": "30 slots", "price": 200000 }]
  basePrice   Int? // paise, for single-price services
  active      Boolean         @default(true)
  createdAt   DateTime        @default(now())
}

// ───────────────────────────── Magazines ─────────────────────────────

enum MagazineType {
  MOVIE
  PERSONAL
  GROUP_DIVA
}

model Magazine {
  id          String       @id @default(cuid())
  title       String
  slug        String       @unique
  type        MagazineType @default(PERSONAL)
  coverUrl    String?
  description String?      @db.Text
  pages       Int          @default(4) // multiples of four
  gsm         Int          @default(190)
  pricePerPage Int         @default(800) // Rs.8 = 800 paise
  pdfUrl      String?
  readOnline  Boolean      @default(true)
  edition     String?
  publishedAt DateTime?
  createdAt   DateTime     @default(now())
}

// ───────────────────────────── Blog ─────────────────────────────

model BlogPost {
  id          String        @id @default(cuid())
  title       String
  slug        String        @unique
  excerpt     String?
  body        String        @db.Text
  coverUrl    String?
  linkUrl     String? // optional external article link
  // Submissions from authors/customers start unpublished; admin approves what shows.
  submittedByUserId String?
  submittedByName   String?
  published   Boolean       @default(true)
  likes       Int           @default(0)
  publishedAt DateTime      @default(now())
  comments    BlogComment[]
}

model BlogComment {
  id        String   @id @default(cuid())
  postId    String
  post      BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  authorName String
  body      String   @db.Text
  createdAt DateTime @default(now())
}

// ───────────────────────────── Events / Competitions ─────────────────────────────

enum EventType {
  EVENT
  COMPETITION
  COLLABORATION
  AWARD
  RECORD
}

model Event {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  type        EventType @default(COMPETITION)
  description String?   @db.Text
  bannerUrl   String?
  startsAt    DateTime?
  endsAt      DateTime?
  isOpen      Boolean   @default(true)
  createdAt   DateTime  @default(now())

  participants EventParticipation[]
}

// A submission when someone clicks "Participate" on an event/competition.
model EventParticipation {
  id         String   @id @default(cuid())
  // eventId is optional because some events are shown from a static fallback
  // list (not yet stored in the DB); eventTitle always captures the entry.
  eventId    String?
  event      Event?   @relation(fields: [eventId], references: [id], onDelete: SetNull)
  eventTitle String
  name       String
  email      String
  phone      String?
  category   String?  // e.g. Photography / Poetry — the contest category
  message    String?  @db.Text
  entryUrl   String?  // optional link to the submitted work (Drive/portfolio)
  createdAt  DateTime @default(now())

  @@index([eventId])
}

// ───────────────────────────── Cart, Orders & Payments ─────────────────────────────

enum CartItemKind {
  BOOK
  SERVICE
  MAGAZINE
}

model CartItem {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      CartItemKind
  refId     String // id of the Book / Service / Magazine
  title     String
  unitPrice Int // paise
  quantity  Int          @default(1)
  meta      Json? // e.g. { format: "paperback", tier: "30 slots" }
  createdAt DateTime     @default(now())

  @@index([userId])
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  FULFILLED
}

model Order {
  id              String      @id @default(cuid())
  userId          String
  user            User        @relation(fields: [userId], references: [id])
  status          OrderStatus @default(PENDING)
  subtotal        Int         @default(0) // paise, before tax/shipping
  discountAmount  Int         @default(0) // paise, promo / personal discount
  taxAmount       Int         @default(0) // paise, GST on services
  shippingCost    Int         @default(0) // paise
  totalAmount     Int // paise (subtotal - discount + tax + shipping)
  currency        String      @default("INR")

  // Razorpay references
  razorpayOrderId   String? @unique
  razorpayPaymentId String?
  razorpaySignature String?

  // Structured delivery address
  shippingName     String?
  shippingPhone    String?
  shippingHouse    String? // flat / house no., building
  shippingArea     String? // street / area / locality
  shippingCity     String?
  shippingState    String?
  shippingPincode  String?
  shippingLandmark String?
  shippingMapUrl   String? @db.Text // optional Google Maps link
  shippingAddress  String? @db.Text // composed full address (for display/emails)

  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  items     OrderItem[]

  @@index([userId])
}

model OrderItem {
  id        String       @id @default(cuid())
  orderId   String
  order     Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  kind      CartItemKind
  refId     String
  bookId    String?
  book      Book?        @relation(fields: [bookId], references: [id])
  title     String
  unitPrice Int
  quantity  Int          @default(1)
  meta      Json?

  @@index([orderId])
}

// ───────────────────────────── Contact / Newsletter ─────────────────────────────

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  message   String   @db.Text
  createdAt DateTime @default(now())
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

// ───────────────────────────── Collaborations (DAA, Pixcorto, ...) ─────────────────────────────
enum CollaborationStatus {
  ACTIVE
  COMING_SOON
}

model Collaboration {
  id          String              @id @default(cuid())
  name        String
  slug        String              @unique
  tagline     String?
  description String?             @db.Text
  imageUrl    String?
  linkUrl     String? // internal (/daa-magazine) or external
  status      CollaborationStatus @default(ACTIVE)
  sortOrder   Int                 @default(0)
  published   Boolean             @default(true)
  createdAt   DateTime            @default(now())
}

// ───────────────────────────── News (admin-managed, homepage carousel) ─────────────────────────────
model News {
  id        String   @id @default(cuid())
  title     String
  summary   String?  @db.Text
  imageUrl  String?
  linkUrl   String? // optional link (internal or external)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
}

// ───────────────────────────── Site settings (admin-configurable) ─────────────────────────────
// Key/value config, e.g. "shipping" => { standardCharge, freeAbove } (paise).
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
