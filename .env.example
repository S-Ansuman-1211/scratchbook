# ─────────────────────────────────────────────────────────────
# ScratchBook Publications — Environment Variables
# Copy this file to ".env" and fill in real values.
# ─────────────────────────────────────────────────────────────

# Database (PostgreSQL). Use Neon, Supabase, or Railway.
# Example: postgresql://user:password@host:5432/scratchbook?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/scratchbook?sslmode=require"

# Auth.js / NextAuth
# Generate a secret with:  openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Razorpay Payment Gateway
# CLIENT must provide these from dashboard.razorpay.com → Settings → API Keys.
# Use rzp_test_ keys for testing; rzp_live_ keys (after KYC) for real money.
# UPI / Google Pay / PhonePe / cards / netbanking all work inside Razorpay checkout.
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="xxxxxxxxxxxxxxxxxxxxxxxx"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxxx"
# Webhook secret — any strong string you choose; set the SAME value in the
# Razorpay dashboard (Settings → Webhooks) for events payment.captured & order.paid.
RAZORPAY_WEBHOOK_SECRET=""

# Vercel Blob — for admin image uploads (book covers, blog images).
# Auto-set on Vercel when you connect a Blob store to the project
# (Vercel → Storage → Create Blob Store → connect). Needed only for uploads.
BLOB_READ_WRITE_TOKEN=""

# Public base URL used to build the payment redirect/callback URLs.
# Locally: http://localhost:3000  ·  In production: your live domain.
APP_BASE_URL="http://localhost:3000"

# Email (optional). Without RESEND_API_KEY, emails are logged to the console
# instead of sent — the app works either way.
# Get a free key at https://resend.com
RESEND_API_KEY=""
EMAIL_FROM="ScratchBook <onboarding@resend.dev>"
CONTACT_INBOX="hello@scratchbookpublications.com"
