# ─────────────────────────────────────────────────────────────
# ScratchBook Publications — Environment Variables
# Copy this file to ".env" and fill in real values.
# ─────────────────────────────────────────────────────────────

# Database (PostgreSQL). Use Neon, Supabase, or Railway.
# Example: postgresql://user:password@host:5432/scratchbook?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/scratchbook?sslmode=require"

# Auth.js / NextAuth
# Generate a secret with:  openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# PhonePe Payment Gateway (Standard Checkout)
# CLIENT must provide these from their PhonePe Business dashboard (Developer Settings).
# Use PHONEPE_ENV="SANDBOX" for testing, "PRODUCTION" for live.
PHONEPE_CLIENT_ID="TEST-Mxxxxxxxxxxxxx"
PHONEPE_CLIENT_SECRET="xxxxxxxxxxxxxxxxxxxxxxxx"
PHONEPE_CLIENT_VERSION="1"
PHONEPE_ENV="SANDBOX"

# Credentials for validating PhonePe's server-to-server webhook callbacks.
# You set these yourself in the PhonePe dashboard (any username/password you choose).
PHONEPE_CALLBACK_USERNAME="scratchbook_webhook"
PHONEPE_CALLBACK_PASSWORD="choose-a-strong-secret"

# Public base URL used to build the payment redirect/callback URLs.
# Locally: http://localhost:3000  ·  In production: your live domain.
APP_BASE_URL="http://localhost:3000"

# Email (optional). Without RESEND_API_KEY, emails are logged to the console
# instead of sent — the app works either way.
# Get a free key at https://resend.com
RESEND_API_KEY=""
EMAIL_FROM="ScratchBook <onboarding@resend.dev>"
CONTACT_INBOX="hello@scratchbookpublications.com"
